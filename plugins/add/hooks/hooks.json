{
  "description": "세션 시작 시 main 클론의 .add/handoff.md 를 컨텍스트에 넣고, 읽기 전용 agent 의 Bash 를 허용 목록의 조회 명령으로 제한하고, add:reviewer 의 반환 양식을 검사하고, 압축 요약에 남길 진행 상태를 지시한다",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo ./.git)\")/.add/handoff.md\"; [ -f \"$f\" ] && { echo \"# 이전 세션 인계 ($f)\"; cat \"$f\"; }; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/readonly-agent.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^add:reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/review-format.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact.sh\""
          }
        ]
      }
    ]
  }
}
