{
  "permissions": {
    "allow": [
      "Bash(claude plugin validate .)",
      "Bash(sh tests/merge-gate.test.sh)",
      "Bash(sh tests/commit-gate.test.sh)",
      "Bash(sh tests/pre-commit.test.sh)",
      "Bash(sh tests/spec-trace.test.sh)",
      "Bash(sh tests/verify.test.sh)",
      "Bash(sh tests/review-format.test.sh)",
      "Bash(sh tests/review-prompt.test.sh)",
      "Bash(sh tests/readonly-agent.test.sh)",
      "Bash(sh tests/skill-size.test.sh)",
      "Bash(sh tests/render.test.sh)",
      "Bash(sh tests/mutation.test.sh)",
      "Bash(sh tests/runtime.test.sh)",
      "Bash(sh tests/probe.test.sh)",
      "Bash(sh tests/readme-commands.test.sh)",
      "Bash(sh tests/cleanup.test.sh)",
      "Bash(sh plugins/adk/template/.github/spec-trace.sh -- ':(exclude)docs/' ':(exclude)*.md' ':(exclude)plugins/adk/template/docs/' ':(exclude).github/spec-trace.sh' ':(exclude)plugins/adk/template/.github/spec-trace.sh')",
      "Bash(sh .claude/hooks/verify.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git worktree add:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge --squash:*)",
      "Bash(gh stack merge:*)",
      "Bash(gh stack view:*)",
      "Bash(git worktree remove:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(service-account*.json)",
      "Bash(git *--no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git * commit -n*)",
      "Bash(git * commit * -n *)",
      "Bash(git * commit * -n)",
      "Bash(*hooksPath*)",
      "Bash(*hookspath*)",
      "Bash(*HOOKSPATH*)",
      "Bash(*GIT_CONFIG*)",
      "Bash(git *commit-tree*)",
      "Bash(git *hash-object*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/hooks/hooks-path.sh 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "onFailure": "block",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/hooks/hooks-path.sh --check"
          },
          {
            "type": "command",
            "if": "Bash(git * commit*)",
            "onFailure": "block",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/hooks/hooks-path.sh --check"
          },
          {
            "type": "command",
            "onFailure": "block",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-gate.sh\""
          },
          {
            "type": "command",
            "onFailure": "block",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-gate.sh\""
          }
        ]
      }
    ]
  }
}
